# Server-side only. Copy to .env for local development, or set these in your host's
# environment settings. Never prefix any of them with VITE_ and never commit real values.

# OpenAI key used by the assistant.
OPENAI_API_KEY=

# Chat analytics. PostgreSQL connection string where visitor questions are stored.
# On Render, use the Internal Database URL of your Postgres instance.
DATABASE_URL=

# Long random secret (16+ characters) that protects the analytics export endpoint.
# Generate one with:  openssl rand -hex 32
ANALYTICS_ADMIN_KEY=

# Optional: override the model declared in server/assistant/config.ts.
# OPENAI_MODEL=
